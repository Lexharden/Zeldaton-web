# --- Frontend -------------------------------------------------------------------------------
# Mock mode needs no backend (fake data + simulated events).
VITE_MOCK_MODE=true
VITE_DEMO_MODE=true
VITE_API_URL=
VITE_WS_URL=

# Real backend (see README): set MOCK_MODE=false and point at the server.
#   VITE_MOCK_MODE=false
#   VITE_API_URL=http://localhost:8080/api
#   VITE_WS_URL=ws://localhost:8080/ws
# Behind the host nginx (same domain) use relative paths:
#   VITE_API_URL=/api
#   VITE_WS_URL=/ws

# --- Docker / VPS (docker-compose.yml reads these from .env) --------------------------------
# Public domain served by the host nginx (used for CORS).
SITE_ADDRESS=zeldathon.example.com
# Local ports the host nginx proxies to (127.0.0.1 only). Defaults: backend 8080, website 8081.
# Change them if those ports are taken; keep deploy/nginx.conf pointing at the same ones.
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Organizer token, REQUIRED (>= 16 chars): openssl rand -hex 32
ADMIN_TOKEN=
# First organizer account for /admin (created only while there are no users). ADMIN_PASSWORD needs
# >= 12 characters; if empty, a random one is printed ONCE in `docker compose logs backend`.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Discord notifications. Each channel has its own webhook (Channel settings > Integrations > Webhooks >
# Copy URL). They are SECRETS: never share them or commit them. Empty = that channel is off. Turn each
# one on, and pick which notices it receives, in /admin > Evento > Discord. Links use https://SITE_ADDRESS.
#   public: the community channel (live, winner, ran out of time, bosses, new leader)
DISCORD_WEBHOOK_URL=
#   staff: the referees' private channel (long disconnections, low time, donation caps, suspicious
#   progress, event state, organizer actions)
DISCORD_STAFF_WEBHOOK_URL=
#   optional: id of the referees' role (Discord developer mode > right click the role > Copy ID).
#   Only critical staff alerts mention it.
DISCORD_STAFF_ROLE_ID=

# Google Analytics 4 (optional): your measurement id, e.g. G-ABC123XYZ. Empty = no analytics and
# no cookie banner. Docker reads GA_MEASUREMENT_ID; `npm run dev/build` reads VITE_GA_MEASUREMENT_ID.
GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID=
