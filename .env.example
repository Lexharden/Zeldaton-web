# --- Frontend -------------------------------------------------------------------------------
# Mock mode needs no backend (fake data + simulated events).
VITE_MOCK_MODE=true
VITE_DEMO_MODE=true
VITE_API_URL=
VITE_WS_URL=

# Real backend (see README): set MOCK_MODE=false and point at the server.
#   VITE_MOCK_MODE=false
#   VITE_API_URL=http://localhost:8080/api
#   VITE_WS_URL=ws://localhost:8080/ws
# Behind the Caddy proxy (same domain) use relative paths:
#   VITE_API_URL=/api
#   VITE_WS_URL=/ws
