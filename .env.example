# --- Frontend -------------------------------------------------------------------------------
# Mock mode needs no backend (fake data + simulated events).
VITE_MOCK_MODE=true
VITE_DEMO_MODE=true
VITE_API_URL=
VITE_WS_URL=

# Real backend (see README): set MOCK_MODE=false and point at the server.
#   VITE_MOCK_MODE=false
#   VITE_API_URL=http://localhost:8080/api
#   VITE_WS_URL=ws://localhost:8080/ws
# Behind the host nginx (same domain) use relative paths:
#   VITE_API_URL=/api
#   VITE_WS_URL=/ws

# --- Docker / VPS (docker-compose.yml reads these from .env) --------------------------------
# Public domain served by the host nginx (used for CORS).
SITE_ADDRESS=zeldathon.example.com
# Organizer token, REQUIRED (>= 16 chars): openssl rand -hex 32
ADMIN_TOKEN=
# First organizer account for /admin (created only while there are no users). ADMIN_PASSWORD needs
# >= 12 characters; if empty, a random one is printed ONCE in `docker compose logs backend`.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Google Analytics 4 (optional): your measurement id, e.g. G-ABC123XYZ. Empty = no analytics and
# no cookie banner. Docker reads GA_MEASUREMENT_ID; `npm run dev/build` reads VITE_GA_MEASUREMENT_ID.
GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID=
