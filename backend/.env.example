# Address the server listens on.
BIND=127.0.0.1:8080
# SQLite file (created on first run, tables migrated automatically).
DATABASE_URL=sqlite://zeldathon.db?mode=rwc
# Organizer token for /api/admin/*. REQUIRED in production (>= 16 chars, use a long random value).
ADMIN_TOKEN=
# Browser origins allowed to call the REST API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seconds without a HiveShock heartbeat before a racer is marked offline (their clock stops).
STALE_HEARTBEAT_SECS=20
# Development only: also write the first-run racer tokens to this file. Never deploy it.
# DEV_TOKENS_FILE=dev-tokens.json
# RUST_LOG=info
