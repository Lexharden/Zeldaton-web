# One domain serves the website and proxies the backend, with automatic HTTPS.
# SITE_ADDRESS=zeldathon.example.com  (defaults to localhost for a local run)
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# REST + admin, public live socket and HiveShock ingestion.
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /ws {
		reverse_proxy backend:8080
	}
	handle /ingest* {
		reverse_proxy backend:8080
	}

	# The built website (npm run build -> dist/), SPA fallback for vue-router.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
